# Public frontend configuration. Copy to .env.local for local use.
# Configure these in the final frontend host's environment settings too.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Recommended: actual Das Farm UUID (must match the Supabase function DAS_FARM_ID).
VITE_DAS_FARM_ID=
# Never add Meta keys, Supabase service-role keys, or messaging tokens here.
# Server secrets belong in Supabase Edge Function Secrets.
