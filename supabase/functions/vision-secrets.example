# Copy these values individually into Supabase Edge Function Secrets.
# They configure the farm-advisory function.
# Access is determined by authenticated farm membership, not a farm ID secret.
# Do not commit a populated copy; keep actual keys only in Supabase Secrets.

# Browser origin allowed to call farm-advisory, e.g. http://localhost:5173 for
# local `vite` testing or https://your-site.example in production (no subpath
# or trailing slash).
VISION_SITE_ORIGIN=

# Meta Model API key (https://dev.meta.ai). Required for all photo analysis.
META_API_KEY=

# Image-capable chat model for flock distribution + combined advisories.
META_VISION_MODEL=muse-spark-1.3

# Segmentation model for candidate chicken regions in advisory photos.
META_SAM_MODEL=sam-3.1
